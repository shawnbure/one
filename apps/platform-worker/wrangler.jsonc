{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "workrr-platform",
  "account_id": "567f3196420ce625839042b03f9fd706",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "../admin/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true } },
  "routes": [{ "pattern": "one.workrr.ai", "custom_domain": true }],
  "ai": { "binding": "AI" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "workrr-platform",
    "database_id": "67c9313a-e4a5-41ce-948e-4095edb27b95",
    "migrations_dir": "migrations"
  }],
  "durable_objects": { "bindings": [{ "name": "PROCESS_AGENT", "class_name": "ProcessAgent" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProcessAgent"] }],
  "queues": {
    "producers": [{ "binding": "PROCESS_QUEUE", "queue": "workrr-process-jobs" }],
    "consumers": [{
      "queue": "workrr-process-jobs",
      "max_batch_size": 10,
      "max_batch_timeout": 5,
      "max_retries": 5,
      "dead_letter_queue": "workrr-process-jobs-dlq"
    }]
  },
  "workflows": [
    { "name": "workrr-process-workflow", "binding": "PROCESS_WORKFLOW", "class_name": "ProcessWorkflow" },
    { "name": "workrr-evaluation-workflow", "binding": "EVALUATION_WORKFLOW", "class_name": "EvaluationWorkflow" }
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_DOMAIN": "one.workrr.ai",
    "ACCESS_TEAM_DOMAIN": "https://workrr-one.cloudflareaccess.com",
    "ACCESS_AUD": "37177f7d83f8b4f4905fccf2f0f04785a17ee9e46809ef2bd2cbb09e15c44ee0"
  },
  "env": {
    "dev": {
      "name": "workrr-platform-dev",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [{ "pattern": "one-dev.workrr.ai", "custom_domain": true }],
      "assets": {
        "directory": "../admin/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/health"]
      },
      "ai": { "binding": "AI" },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "workrr-platform-dev",
        "database_id": "5dad1856-7790-496c-bc17-91cddd655dd7",
        "migrations_dir": "migrations"
      }],
      "durable_objects": { "bindings": [{ "name": "PROCESS_AGENT", "class_name": "ProcessAgent" }] },
      "queues": {
        "producers": [{ "binding": "PROCESS_QUEUE", "queue": "workrr-process-jobs-dev" }],
        "consumers": [{
          "queue": "workrr-process-jobs-dev",
          "max_batch_size": 10,
          "max_batch_timeout": 5,
          "max_retries": 5,
          "dead_letter_queue": "workrr-process-jobs-dev-dlq"
        }]
      },
      "workflows": [
        { "name": "workrr-process-workflow-dev", "binding": "PROCESS_WORKFLOW", "class_name": "ProcessWorkflow" },
        { "name": "workrr-evaluation-workflow-dev", "binding": "EVALUATION_WORKFLOW", "class_name": "EvaluationWorkflow" }
      ],
      "triggers": { "crons": ["0 * * * *"] },
      "vars": {
        "ENVIRONMENT": "development",
        "APP_DOMAIN": "one-dev.workrr.ai",
        "ACCESS_TEAM_DOMAIN": "https://workrr-one.cloudflareaccess.com",
        "ACCESS_AUD": "27ae84d632232f993e89fb6d9b0489ed6683758137d99fabee869f4a3840656b"
      }
    }
  }
}
