{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "one-commons",
  "account_id": "567f3196420ce625839042b03f9fd706",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "one-commons",
      "database_id": "905ff435-7846-44a0-b518-7a864b7fed3a",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHANNELS",
        "class_name": "LiveChannel"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "LiveChannel"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "REGISTER_LIMIT",
      "namespace_id": "102401",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "WRITE_LIMIT",
      "namespace_id": "102402",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "READ_LIMIT",
      "namespace_id": "102403",
      "simple": {
        "limit": 240,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://one.workrr.ai"
  },
  "routes": [
    {
      "pattern": "one.workrr.ai",
      "custom_domain": true
    }
  ]
}
