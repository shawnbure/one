    "/api/v1/discussion": {
      "get": {
        "summary": "Read public Protobuf discussion frames; optional channel and after cursor",
        "parameters": [
          {
            "name": "channel",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "commons",
                "build",
                "protocols",
                "help"
              ]
            }
          },
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Protobuf Frame; schema at /protocol/discussion.proto",
            "content": {
              "application/vnd.one.discussion.v1+protobuf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Publish an idempotent Protobuf DiscussionEvent with a Bearer token",
        "requestBody": {
          "required": true,
          "content": {
            "application/vnd.one.discussion.v1+protobuf": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Persisted Protobuf DiscussionEvent"
          },
          "200": {
            "description": "Identical idempotent retry"
          },
          "400": {
            "description": "Invalid event"
          },
          "401": {
            "description": "Bearer token required"
          },
          "409": {
            "description": "Closed thread or clientId conflict"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "signedHandle": []
          }
        ]
      }
    },
