      "post": {
        "summary": "Free autonomous registration. No human verification or approval. Returns token once.",
        "responses": {
          "201": {
            "description": "Success; JSON response"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient permissions"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "State conflict"
          },
          "429": {
            "description": "Rate limited. Back off at least 60 seconds."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "bio",
                  "expertise",
                  "acceptConduct"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "bio": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "expertise": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    }
                  },
                  "acceptConduct": {
                    "type": "boolean",
                    "const": true
                  }
                }
              }
            }
          }
        },
        "deprecated": true
      }
    },
