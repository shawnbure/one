{
  "schemaVersion": 1,
  "process": {
    "name": "Scheduled Record Reconciliation",
    "description": "Read two bounded record sets, compare approved keys and totals, and prepare an exception report for owner review.",
    "executionProfile": "workflow",
    "modelProfile": "fast",
    "modelId": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "autonomy": "suggest",
    "tools": ["primary_records_read", "comparison_records_read"],
    "toolDefinitions": [
      {
        "name": "primary_records_read",
        "version": 1,
        "adapterKind": "http",
        "handlerKey": null,
        "accessMode": "read",
        "riskLevel": "low",
        "dataClassification": "confidential",
        "rateLimitPerMinute": 10,
        "inputSchemaJson": "{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"periodStart\",\"periodEnd\"],\"properties\":{\"periodStart\":{\"type\":\"string\"},\"periodEnd\":{\"type\":\"string\"},\"cursor\":{\"type\":\"string\",\"maxLength\":200}}}",
        "outputSchemaJson": "{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"records\",\"complete\"],\"properties\":{\"records\":{\"type\":\"array\",\"maxItems\":500,\"items\":{\"type\":\"object\"}},\"complete\":{\"type\":\"boolean\"},\"nextCursor\":{\"type\":\"string\"}}}",
        "description": "Read a bounded page from the authoritative primary record source.",
        "owner": "Operations",
        "supportInstructions": "Bind to a code-owned fixed endpoint. Enforce the same period and maximum 500-record page."
      },
      {
        "name": "comparison_records_read",
        "version": 1,
        "adapterKind": "http",
        "handlerKey": null,
        "accessMode": "read",
        "riskLevel": "low",
        "dataClassification": "confidential",
        "rateLimitPerMinute": 10,
        "inputSchemaJson": "{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"periodStart\",\"periodEnd\"],\"properties\":{\"periodStart\":{\"type\":\"string\"},\"periodEnd\":{\"type\":\"string\"},\"cursor\":{\"type\":\"string\",\"maxLength\":200}}}",
        "outputSchemaJson": "{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"records\",\"complete\"],\"properties\":{\"records\":{\"type\":\"array\",\"maxItems\":500,\"items\":{\"type\":\"object\"}},\"complete\":{\"type\":\"boolean\"},\"nextCursor\":{\"type\":\"string\"}}}",
        "description": "Read a bounded page from the approved comparison record source.",
        "owner": "Operations",
        "supportInstructions": "Bind to a code-owned fixed endpoint. Enforce the same period and maximum 500-record page."
      }
    ],
    "businessOwner": "Operations",
    "department": "Operations",
    "riskLevel": "medium",
    "dataClassification": "confidential"
  },
  "behavior": {
    "systemPrompt": "You are a private operations reconciliation analyst. Compare only the supplied primary and comparison records. Produce an attributable exception report; do not alter either source and do not claim an exception is resolved.",
    "instructions": [
      "Use the configured period and match key consistently for both sources.",
      "Separate missing, duplicate, amount-variance, and late-arrival exceptions.",
      "Cite the source record identifiers for every exception.",
      "Report counts, compared totals, material variances, and unresolved questions."
    ],
    "guardrails": [
      "Never invent a record, identifier, amount, timestamp, or match.",
      "Never write to either source or mark an exception resolved.",
      "Do not compare records outside the approved bounded period.",
      "Route ambiguous duplicates and material variances to the process owner."
    ],
    "releaseNotes": "Reference scheduled-reconciliation solution pack 1.0.0",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodStart", "periodEnd", "matchKey", "materialVariance"],
      "properties": {
        "periodStart": {"type": "string", "minLength": 10, "maxLength": 40},
        "periodEnd": {"type": "string", "minLength": 10, "maxLength": 40},
        "matchKey": {"type": "string", "minLength": 1, "maxLength": 100},
        "materialVariance": {"type": "number", "minimum": 0}
      }
    },
    "outputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordsCompared", "exceptions", "primaryTotal", "comparisonTotal", "reviewRequired"],
      "properties": {
        "recordsCompared": {"type": "integer", "minimum": 0},
        "exceptions": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": ["type", "recordId", "detail"],
            "properties": {
              "type": {"type": "string", "enum": ["missing", "duplicate", "variance", "late_arrival"]},
              "recordId": {"type": "string", "maxLength": 160},
              "detail": {"type": "string", "maxLength": 500}
            }
          }
        },
        "primaryTotal": {"type": "number"},
        "comparisonTotal": {"type": "number"},
        "reviewRequired": {"type": "boolean"}
      }
    },
    "topology": {
      "businessSteps": [
        {"type": "step", "label": "Read bounded source periods"},
        {"type": "step", "label": "Match approved record keys"},
        {"type": "decision", "label": "Classify material exceptions"},
        {"type": "checkpoint", "label": "Prepare owner exception report"}
      ]
    },
    "acceptanceCases": [
      {
        "name": "Missing comparison record",
        "input": "{\"periodStart\":\"2026-07-01\",\"periodEnd\":\"2026-07-01\",\"matchKey\":\"recordId\",\"materialVariance\":1,\"facts\":\"Primary contains R-104 for 125.00; comparison has no R-104.\"}",
        "contains": ["R-104", "missing", "reviewRequired"],
        "prohibited": ["balanced", "resolved"],
        "maxChars": 5000
      },
      {
        "name": "Balanced period",
        "input": "{\"periodStart\":\"2026-07-01\",\"periodEnd\":\"2026-07-01\",\"matchKey\":\"recordId\",\"materialVariance\":1,\"facts\":\"Both sources contain R-201 10.00, R-202 20.00, and R-203 30.00.\"}",
        "contains": ["recordsCompared", "exceptions", "60"],
        "prohibited": ["missing record", "material variance"],
        "maxChars": 5000
      },
      {
        "name": "Material amount variance",
        "input": "{\"periodStart\":\"2026-07-01\",\"periodEnd\":\"2026-07-01\",\"matchKey\":\"recordId\",\"materialVariance\":1,\"facts\":\"Primary R-301 is 100.00; comparison R-301 is 92.00.\"}",
        "contains": ["R-301", "variance", "8"],
        "prohibited": ["resolved", "within threshold"],
        "maxChars": 5000
      }
    ]
  },
  "provenance": {
    "sourceProcessId": "workrr-reference-scheduled-reconciliation"
  },
  "secrets": "excluded"
}
