{
  "name": "workrr-one",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @workrr/admin",
    "dev:worker": "npm run dev -w @workrr/platform-worker",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test scripts/*.test.mjs",
    "validate:repository": "node scripts/validate-repository.mjs",
    "verify": "npm run validate:repository && npm run typecheck && npm run test && npm run build",
    "provision:plan": "node scripts/provision-cloudflare.mjs",
    "customer:config": "node scripts/generate-customer-config.mjs",
    "cf:types": "npm run cf:types -w @workrr/platform-worker",
    "access:sync": "node scripts/sync-cloudflare-access.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "promote:production": "node scripts/promote-production.mjs"
  },
  "engines": { "node": ">=22" }
}
